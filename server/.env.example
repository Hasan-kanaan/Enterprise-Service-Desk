# Copy to .env for LOCAL use. Load it explicitly with Node --env-file=.env.
# Only development/test permit a JWT default. Omitted/unknown modes fail closed.
NODE_ENV=development
PORT=8000
# Supply your own local database connection; never point tests at this database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/service_desk
# Required strong independent secrets in deployed modes: generate each with
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# JWT may be blank only for explicit local development/test.
JWT_SECRET=
# Required even locally; no default, no database storage. Never prefix with VITE_.
INITIAL_SETUP_SECRET=
# Production requires explicit HTTPS origins, comma separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000
REFRESH_COOKIE_SAME_SITE=lax
# false by default. Or a known hop count / comma-separated trusted IP/CIDR list.
TRUST_PROXY=false
REQUEST_BODY_LIMIT_BYTES=102400
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=600000
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS=600000
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MS=60000
RATE_LIMIT_SETUP_MAX=5
RATE_LIMIT_SETUP_WINDOW_MS=600000
AUTO_CLOSE_AFTER_HOURS=72
STORAGE_PROVIDER=local
ATTACHMENT_STORAGE_DIR=.attachments
# Optional future storage configuration only; these do not provision resources.
# GCS_BUCKET_NAME=
# GCS_PROJECT_ID=
# Use workload identity/ADC if selecting gcs. Never commit credential files.
# TEST_DATABASE_URL must independently identify an isolated database ending _test.

# Account/security email only; local Mailpit (never production defaults).
MAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Enterprise Service Desk <accounts@localhost>
APP_PUBLIC_URL=http://localhost:3000
